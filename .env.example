# Copy to .env.local. Without these, local development runs on dev fixtures (sample data, clearly marked).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only (webhook ingress, relay, document service). Never expose to the browser.
SUPABASE_SECRET_KEY=

# Preview deployments without a database may opt in to the dev fixtures. Never set in production.
KOOBI_DEV_SEED=false

# Test accounts, one per role, password sign-in at /signin/test (dev and staging only, never production).
# Create them with: npm run test-users  (needs SUPABASE_SECRET_KEY; generates the password if empty)
KOOBI_TEST_LOGINS=false
KOOBI_TEST_PASSWORD=

# Integrations (sprint 4 onward); sandbox keys in dev and staging.
# Paystack: without a key, development and test-login deployments use the payment sandbox.
PAYSTACK_SECRET_KEY=
# Paystack needs an email per customer; phone-only payers get payer-<id>@<this domain>.
PAYSTACK_EMAIL_DOMAIN=payers.koobi.co.ke
# Field encryption for KRA PINs and payout numbers (sprint 6): 32 random bytes, base64
# (openssl rand -base64 32). Server only. Development and test-login deployments fall back to a
# fixed development key when unset, which must never protect real data.
KOOBI_FIELD_KEY=
# Notifications (sprint 7). Without keys, development and test-login deployments use a sandbox
# that sends nothing. Use AFRICASTALKING_USERNAME=sandbox for the Africa's Talking simulator.
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
AFRICASTALKING_SENDER_ID=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
RESEND_API_KEY=
EMAIL_FROM=Koobi <hello@koobi.co.ke>
# Links in messages, and the secret Supabase sends when it calls /api/notifications/dispatch.
# Put the same two values in Supabase Vault as koobi_dispatch_url (…/api/notifications/dispatch)
# and koobi_cron_secret (see supabase/migrations/20261106000600_cron_notifications.sql).
KOOBI_APP_URL=https://koobi.co.ke
CRON_SECRET=
SMILE_ID_PARTNER_ID=
SMILE_ID_API_KEY=
GOOGLE_MAPS_API_KEY=
SENTRY_DSN=
