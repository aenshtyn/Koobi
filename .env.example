# Copy to .env.local. Without these, local development runs on dev fixtures (sample data, clearly marked).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only (webhook ingress, relay, document service). Never expose to the browser.
SUPABASE_SECRET_KEY=

# Preview deployments without a database may opt in to the dev fixtures. Never set in production.
KOOBI_DEV_SEED=false

# Test accounts, one per role, password sign-in at /signin/test (dev and staging only, never production).
# Create them with: npm run test-users  (needs SUPABASE_SECRET_KEY; generates the password if empty)
KOOBI_TEST_LOGINS=false
KOOBI_TEST_PASSWORD=

# Integrations (sprint 4 onward); sandbox keys in dev and staging.
# Paystack: without a key, development and test-login deployments use the payment sandbox.
PAYSTACK_SECRET_KEY=
# Paystack needs an email per customer; phone-only payers get payer-<id>@<this domain>.
PAYSTACK_EMAIL_DOMAIN=payers.koobi.co.ke
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
RESEND_API_KEY=
SMILE_ID_PARTNER_ID=
SMILE_ID_API_KEY=
GOOGLE_MAPS_API_KEY=
SENTRY_DSN=
